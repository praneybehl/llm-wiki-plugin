{
  "name": "paperclip-plugin-llm-wiki",
  "version": "0.0.1",
  "type": "module",
  "description": "Surface the LLM Wiki inside Paperclip — search, browse, and read company knowledge in context.",
  "author": "Praney Behl",
  "license": "MIT",
  "homepage": "https://github.com/praneybehl/llm-wiki-plugin/tree/main/integrations/paperclip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praneybehl/llm-wiki-plugin.git",
    "directory": "integrations/paperclip/plugin"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "llm-wiki",
    "knowledge-base",
    "wiki"
  ],
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node ./esbuild.config.mjs",
    "build:watch": "node ./esbuild.config.mjs --watch",
    "prepublish:check": "node ./scripts/prepublish-checks.mjs",
    "prepublishOnly": "node ./scripts/prepublish-checks.mjs"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "2026.428.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.428.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
